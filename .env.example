# AI Studio automatically injects GEMINI_API_KEY and APP_URL
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Google Calendar Integration (Service Account)
# Servis hesabının JSON içeriği tek satır dize veya base64 olarak girilir.
# Sadece Google Calendar API yetkisine sahip olmalıdır.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Salonun Google Takvim ID'si (örn: salon@gmail.com veya xxx@group.calendar.google.com)
CALENDAR_ID=""

# E-posta (SMTP) Yapılandırması
# revDSG ve güvenlik gereği: ana e-posta şifrenizi değil, sağlayıcınızdan oluşturulmuş uygulama şifresini (App Password) girin.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Revair Studio <termin@revair-studio.ch>"

# Güvenlik & İptal Token Sırrı (Opsiyonel / Rastgele 64-karakter hex)
TOKEN_SECRET=""

